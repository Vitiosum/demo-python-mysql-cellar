# Local development only. On Clever Cloud, the linked add-ons inject these.
# MySQL add-on
MYSQL_ADDON_URI=mysql://root@127.0.0.1:3306/herbarium
# Cellar add-on (locally: a moto S3 server, see README)
CELLAR_ADDON_HOST=http://127.0.0.1:9100
CELLAR_ADDON_KEY_ID=local-key
CELLAR_ADDON_KEY_SECRET=local-secret
# Only for the local moto emulator (Cellar itself uses region "default")
AWS_DEFAULT_REGION=us-east-1
# Optional: force the bucket name (default: derived from the Cellar key id)
# CELLAR_BUCKET=herbarium-local
PORT=8080
